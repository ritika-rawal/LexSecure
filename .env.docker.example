# Copy this file to .env.docker and replace every placeholder before startup.
MONGO_ROOT_USERNAME=lexsecure_root
MONGO_ROOT_PASSWORD=ReplaceWithAStrongUniqueRootPassword1!
MONGO_DATABASE=lexsecure
MONGO_APP_USERNAME=lexsecure_app
MONGO_APP_PASSWORD=ReplaceWithADifferentStrongAppPassword1!

SESSION_SECRET=ReplaceWithAtLeast32RandomCharactersForSessions!
DOCUMENT_ENCRYPTION_KEY=ReplaceWith32RandomBytesEncodedAsBase64
MESSAGE_ENCRYPTION_KEY=ReplaceWithDifferent32RandomBytesEncodedAsBase64
AUDIT_LOG_HMAC_KEY=ReplaceWithAnother32RandomBytesEncodedAsBase64
MFA_ENCRYPTION_KEY=ReplaceWithADedicated32RandomBytesEncodedAsBase64
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1

# Password reset email is optional in the local container environment.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
