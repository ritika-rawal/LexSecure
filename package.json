{
  "name": "lexsecure",
  "version": "0.1.0",
  "private": true,
  "description": "Secure Lawyer Appointment and Client Management System coursework project.",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "install:all": "npm install --workspaces",
    "docker:config": "docker compose --env-file .env.docker config",
    "docker:up": "docker compose --env-file .env.docker up --build",
    "docker:down": "docker compose --env-file .env.docker down"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
