NODE_ENV=development
EXPOSE_ERROR_DETAILS=true
PORT=5000
CLIENT_ORIGIN=http://localhost:3000
TRUST_PROXY_HOPS=0
MONGODB_URI=mongodb://127.0.0.1:27017/lexsecure
SESSION_SECRET=ReplaceWithAtLeast32RandomChars!!2026
DOCUMENT_ENCRYPTION_KEY=ReplaceWith32RandomBytesEncodedAsBase64
MESSAGE_ENCRYPTION_KEY=ReplaceWithDifferent32RandomBytesEncodedAsBase64
AUDIT_LOG_HMAC_KEY=ReplaceWithAnother32RandomBytesEncodedAsBase64
MFA_ENCRYPTION_KEY=ReplaceWithADedicated32RandomBytesEncodedAsBase64
PASSWORD_RESET_URL=http://localhost:3000/reset-password
PASSWORD_MAX_AGE_DAYS=90
PASSWORD_HISTORY_SIZE=5

# Cloudflare Turnstile development key. Use a real restricted secret in production.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1

# Configure a TLS-capable SMTP account to enable password reset delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Used only by `npm run create:admin`. Remove these values after creating the account.
ADMIN_FULL_NAME=LexSecure Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ReplaceWithAStrongUniquePassword1!
